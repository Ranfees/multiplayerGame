<!DOCTYPE html>
<html>

<head>
    <style>
        html,body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #222;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        #myCanvas {
            border:4px solid #000000;
            background-color: rgb(160, 133, 189);
            max-width: 100%;
            max-height: 100%;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
            display: none;
        }
        
        #lobby {
            background-color: #333;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.6);
            color: white;
            text-align: center;
            display: flex;
            flex-direction: column;
            gap: 20px;
            min-width: 300px;
        }

        #lobby h1 {
            margin-top: 0;
            margin-bottom: 10px;
        }

        .input-group {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        input {
            padding: 10px;
            font-size: 16px;
            border: none;
            border-radius: 6px;
            width: 150px;
            text-transform: uppercase;
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            border: none;
            border-radius: 6px;
            background-color: #4CAF50;
            color: white;
            transition: background-color 0.3s;
        }

        button:hover {
            background-color: #45a049;
        }

        .btn-secondary {
            background-color: #008CBA;
        }

        .btn-secondary:hover {
            background-color: #007bb5;
        }

        #message {
            margin-top: 15px;
            font-weight: bold;
            color: #ff9800;
        }

        #roomDisplay {
            display: none;
            background-color: #444;
            padding: 20px;
            border-radius: 8px;
            margin-top: 10px;
        }

        #roomCode {
            font-size: 24px;
            letter-spacing: 3px;
            color: #4CAF50;
            font-weight: bold;
            user-select: all;
        }
        
        #errorMsg {
            color: #f44336;
            margin-top: 10px;
        }

    </style>
</head>

<body>

    <div id="lobby">
        <h1>Pong Multiplayer</h1>
        <button id="createBtn" onclick="createRoom()">Create New Room</button>
        <div>
            <p>OR</p>
        </div>
        <div class="input-group">
            <input type="text" id="roomInput" placeholder="Room ID" maxlength="6">
            <button class="btn-secondary" id="joinBtn" onclick="joinRoom()">Join Room</button>
        </div>
        
        <div id="errorMsg"></div>

        <div id="roomDisplay">
            <p>Share this Room ID with your friend:</p>
            <div id="roomCode">------</div>
            <p id="message">Waiting for opponent to join...</p>
        </div>
    </div>

    <canvas id="myCanvas" width="1280" height="720"></canvas>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const canvas = document.getElementById('myCanvas');
        const ctx = canvas.getContext('2d');
        const socket = io();

        const lobby = document.getElementById('lobby');

        const cw = 1280;
        const ch = 720;

        let role = 'spectator';
        let isPlaying = false;

        function createRoom() {
            document.getElementById('errorMsg').innerText = '';
            socket.emit('createRoom');
            document.getElementById('createBtn').disabled = true;
            document.getElementById('joinBtn').disabled = true;
            document.getElementById('roomInput').disabled = true;
        }

        function joinRoom() {
            document.getElementById('errorMsg').innerText = '';
            const val = document.getElementById('roomInput').value.trim().toUpperCase();
            if (!val) {
                document.getElementById('errorMsg').innerText = 'Please enter a Room ID';
                return;
            }
            socket.emit('joinRoom', val);
            document.getElementById('createBtn').disabled = true;
            document.getElementById('joinBtn').disabled = true;
            document.getElementById('roomInput').disabled = true;
        }

        socket.on('roomCreated', (roomId) => {
            document.getElementById('roomDisplay').style.display = 'block';
            document.getElementById('roomCode').innerText = roomId;
        });

        socket.on('roomError', (msg) => {
            document.getElementById('errorMsg').innerText = msg;
            document.getElementById('createBtn').disabled = false;
            document.getElementById('joinBtn').disabled = false;
            document.getElementById('roomInput').disabled = false;
        });

        socket.on('role', (assignedRole) => {
            role = assignedRole;
            console.log('Assigned role:', role);
        });

        socket.on('gameStart', () => {
            lobby.style.display = 'none';
            canvas.style.display = 'block';
            isPlaying = true;
            render();
        });

        socket.on('opponentLeft', () => {
            alert('Opponent has left the game!');
            location.reload();
        });

        let gameState = {
            p1: { y: ch / 2 - 50, score: 0 },
            p2: { y: ch / 2 - 50, score: 0 },
            ball: { x: cw / 2, y: ch / 2, radius: 15 }
        };

        socket.on('gameState', (state) => {
            if (isPlaying) {
                gameState = state;
            }
        });

        const keys = { w: false, s: false, ArrowUp: false, ArrowDown: false };

        window.addEventListener('keydown', (e) => {
            if (['w', 's', 'ArrowUp', 'ArrowDown'].includes(e.key)) {
                keys[e.key] = true;
                e.preventDefault(); // Prevent scrolling
            }
        });

        window.addEventListener('keyup', (e) => {
            if (['w', 's', 'ArrowUp', 'ArrowDown'].includes(e.key)) {
                keys[e.key] = false;
            }
        });

        setInterval(() => {
            if (isPlaying && (role === 'p1' || role === 'p2')) {
                if (keys.w || keys.ArrowUp) socket.emit('move', 'up');
                if (keys.s || keys.ArrowDown) socket.emit('move', 'down');
            }
        }, 1000 / 60);

        function drawTable() {
            ctx.fillStyle = "#0b3d91";
            ctx.fillRect(100, 40, cw - 200, ch - 80);

            ctx.strokeStyle = "white";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(cw / 2, 40);
            ctx.lineTo(cw / 2, ch - 40);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(cw / 2, ch / 2, 50, 0, Math.PI * 2);
            ctx.stroke();

            ctx.font = "40px Arial";
            ctx.fillStyle = "white";
            ctx.fillText(gameState.p1.score, cw / 4, 100);
            ctx.fillText(gameState.p2.score, (cw / 4) * 3, 100);

            ctx.font = "20px Arial";
            ctx.fillStyle = "rgba(255,255,255,0.7)";
            ctx.fillText("You are: " + (role === 'p1' ? 'Player 1 (Left)' : 'Player 2 (Right)'), 10, 30);
        }

        function drawPaddle(x, y, color) {
            ctx.fillStyle = color;
            ctx.shadowBlur = 15;
            ctx.shadowColor = color;
            ctx.fillRect(x, y, 20, 100);
            ctx.shadowBlur = 0;
        }

        function drawBall(x, y, radius) {
            ctx.beginPath();
            ctx.fillStyle = "white";
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.closePath();
        }

        function render() {
            if (!isPlaying) return;

            ctx.clearRect(0, 0, cw, ch);
            
            drawTable();
            drawPaddle(120, gameState.p1.y, "red");
            drawPaddle(cw - 140, gameState.p2.y, "lime");
            drawBall(gameState.ball.x, gameState.ball.y, gameState.ball.radius);

            requestAnimationFrame(render);
        }

    </script>
</body>

</html>